}
.toast.warn {
  background: linear-gradient(135deg, rgba(187,128,9,0.95), rgba(158,106,3,0.95));
}
@keyframes toastIn {
  from { opacity: 0; transform: translateY(30px) scale(0.9); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* ============ CONFETTI ============ */
#confetti {
  position: fixed;
  inset: 0;
